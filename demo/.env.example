# Copy to .env and edit. run_demo.sh loads this file automatically.
# On the course VM, MySQL trusts your OS user (auth_socket): leave DB_PASSWORD empty.
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=club_events
# Optional: connect over a unix socket instead of TCP (e.g. /var/run/mysqld/mysqld.sock)
DB_SOCKET=
